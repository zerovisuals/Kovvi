#  ═══════════════════════════════════════════════════════════════════════════
#  KOVVI ENVIRONMENT
#  ═══════════════════════════════════════════════════════════════════════════
#
#  Copy to `.env.local` and fill in what you have.
#
#  Everything below the DATABASE section is OPTIONAL. Kovvi treats a missing
#  credential as a real, visible product state — "not connected" — never as a
#  reason to simulate a result. Nothing here is required to run the app, sign
#  up, research a real website, read real evidence, or prepare outreach.
#
#  `src/server/capabilities/registry.ts` is the single source of truth for
#  which of these are live. The UI, the pipeline and the marketing page all
#  read that one registry, so the product cannot claim a capability it lacks.
#  ═══════════════════════════════════════════════════════════════════════════


# ── Database (required) ─────────────────────────────────────────────────────
# Local development: run `pnpm db:server` in a second terminal. It serves an
# embedded PGlite database over the real Postgres wire protocol, so the app
# speaks plain `node-postgres` in every environment and dev/production DDL
# never diverges. No Postgres install and no Docker required.
DATABASE_URL="postgres://kovvi:kovvi@127.0.0.1:5433/kovvi"

# Production: point at a real Postgres (Neon, Supabase, RDS…). Nothing else
# changes — same driver, same migrations.
# DATABASE_URL="postgres://user:password@host/db?sslmode=require"


# ── Session signing (required) ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Absolute origin the app is served from. Used for cookie scope and callbacks.
AUTH_URL="http://localhost:3000"


# ── Internal review routes (optional) ───────────────────────────────────────
# Enables /tokens (the theme contract, with live contrast measurement) and
# /states (all fifteen required product states). Both `notFound()` otherwise,
# so they never ship to users. Set this while reviewing a supplied identity.
KOVVI_DEV_ROUTES="0"


# ── Job worker (optional) ───────────────────────────────────────────────────
# Unset in development: the worker runs in-process so `pnpm dev` is enough.
# Set to 1 in production, where `pnpm worker` runs as its own process.
# KOVVI_EXTERNAL_WORKER="1"


#  ═══════════════════════════════════════════════════════════════════════════
#  CAPABILITIES — all optional, all absent-not-simulated
#  ═══════════════════════════════════════════════════════════════════════════

# ── AI-assisted drafting ────────────────────────────────────────────────────
# Absent: outreach drafting falls back to deterministic templates grounded in
# the same evidence. It works; it is simply less fluent. There is no code path
# that fabricates prose when this is unset.
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=""

# ── Web search discovery ────────────────────────────────────────────────────
# Absent: discovery is manual URL and CSV import only. Research runs record
# the source as unavailable and results render the "partial results" state,
# rather than quietly returning a shorter list.
# SEARCH_API_PROVIDER=""   # brave | serper | google_places
# SEARCH_API_KEY=""

# ── Transactional email sending ─────────────────────────────────────────────
# Absent: campaigns work fully up to approval; the send button is replaced by
# "copy message" and "log manual send", and the channel table on the marketing
# page says so. Suppression and reply-stop still apply to manual logging.
# https://resend.com/api-keys
# RESEND_API_KEY=""
# KOVVI_SENDING_DOMAIN=""

# ── Subscription billing ────────────────────────────────────────────────────
# Absent: subscription status is `absent`, which is a real rendered state, not
# a fake `active`. Plan allowances still apply, so usage accounting is
# exercised for real.
# https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_ID=""

# ── Object storage for captures ─────────────────────────────────────────────
# Absent: screenshots are stored on the local filesystem behind the same blob
# interface. Fine for development; set these for a serverless deployment,
# where the filesystem is not durable.
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
